SERVER_PORT=4178
SESSION_SECRET=change-this-session-secret

# Admin account. Change before exposing on an intranet server.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Portal SSO client. Employees enter through the portal with a one-time ticket.
SSO_ENABLED=true
SSO_CHECK_TICKET_URL=http://192.168.50.87:8888/sso/checkTicket
SSO_FORBIDDEN_URL=http://192.168.50.87:8888/403
SSO_TIMEOUT_MS=15000

# MDM production personnel and complete organization tree. Credentials stay in .env.
MDM_API_BASE_URL=http://daas-api.wst.com
MDM_CLIENT_ID=
MDM_CLIENT_SECRET=

# Manufacturing Plant 1 knowledge assistant.
# Example: https://pan.wst.com:443
QA_API_BASE_URL=
QA_BOT_ID=7172f29d-69c1-4f71-9646-03ab127e8f53
QA_AUTH_CLIENT_ID=
QA_AUTH_CLIENT_SECRET=
# Optional fallback for local tests when the page is not opened from OA with ?code=...
QA_DEFAULT_ACCOUNT=
# Set to false only when the intranet QA platform uses a certificate not trusted by Node.js.
QA_TLS_REJECT_UNAUTHORIZED=true

# Manufacturing Plant 4 RAGFlow chat assistant. Keep all real credentials in .env only.
RAGFLOW_API_BASE_URL=http://172.28.200.7
RAGFLOW_API_KEY=
RAGFLOW_CHAT_ID=
# Optional total request timeout in milliseconds. Default: 1800000 (30 minutes).
RAGFLOW_TOTAL_TIMEOUT_MS=1800000
# Optional fallback link shown in the native chat page.
RAGFLOW_CHAT_URL=

# Shared intranet model for translation, PDF conversion and standard interpretation.
AI_MODEL_API_URL=http://172.28.200.7:7888/qwen3long/v1/chat/completions
AI_MODEL_NAME=Qwen-Lite
AI_MODEL_API_KEY=

# Document workers and per-Node-process model request limit. Set both workers to 1 for serial.
TRANSLATION_CHUNK_CONCURRENCY=2
DOCUMENT_LAYOUT_CONCURRENCY=2
AI_DOCUMENT_MAX_CONCURRENCY=2
# Retry only transient document model failures, without repeating successful steps (0-2).
AI_DOCUMENT_RETRY_COUNT=1

# Set to true for local UI testing when intranet APIs are unreachable.
MOCK_AI=false
